# Template for storing credentials and secrets.
# Copy this file to .env and fill in real values.
# The .env file must NOT be committed to version control.

# ── Dev Stand ──────────────────────────────────
DEV_USERNAME=admin
DEV_PASSWORD=your_dev_password

DEV_ELASTIC_USER=elastic_user
DEV_ELASTIC_PASS=your_elastic_password

DEV_DB_USER=postgres
DEV_DB_PASS=your_db_password

# ── Test Stand ─────────────────────────────────
TEST_USERNAME=test_user
TEST_PASSWORD=your_test_password

TEST_ELASTIC_USER=elastic_user
TEST_ELASTIC_PASS=your_elastic_password

TEST_DB_USER=postgres
TEST_DB_PASS=your_db_password

# ── Optional Settings ──────────────────────────
# REST_RESPONSE_SIZE_LIMIT=10000
# REST_ENABLE_SSL_VERIFY=false
